{
  "name": "@revolutionarygamesco/piratenames",
  "description": "A Foundry VTT module for generating personal and ship names for the major European powers present in the Caribbean during the Golden Age of Piracy: the Spanish Empire, the British Empire, the Kingdom of France, and the Dutch West India Company.",
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck:build && vite build && npm run pack",
    "pack": "node ./scripts/pack.js",
    "yamlify-personal": "node ./scripts/yamlify-personal.js",
    "complete-table": "node ./scripts/complete-table.js",
    "test": "vitest run --typecheck && npm run typecheck",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.2",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "csv-parse": "^6.1.0",
    "sass": "^1.93.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.1.10",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@revolutionarygamesco/common": "^1.2.6",
    "@revolutionarygamesco/common-foundryvtt": "^0.3.3"
  }
}
